# Auto-start tmux for interactive shells (must be before p10k instant prompt)
if [[ -o interactive ]] && [[ -z "$TMUX" ]]; then
  tmux attach -t main || tmux new -s main
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
export BAT_PAGER="less -FR"
export BAT_THEME="TwoDark"
[[ -d "$HOME/.claude/tmp" ]] && export TMPDIR="$HOME/.claude/tmp"

ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(git)

source $ZSH/oh-my-zsh.sh

alias cat='bat'
alias ls='eza --icons'
alias ll='eza -l --icons --git'
alias la='eza -la --icons --git'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# fzf — path differs by distro; guard in case fzf not yet installed
{{- if eq .chezmoi.osRelease.id "arch" }}
[[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
[[ -f /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh
{{- else }}
[[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
{{- end }}

function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

rgf() {
  local query="$1"
  if [[ -z "$query" ]]; then
    read "query?Search pattern: "
  fi
  rg --line-number --no-heading --color=always "$query" |
    fzf --ansi --delimiter : \
        --preview 'bat --style=numbers --color=always --highlight-line {2} {1}' \
        --bind 'enter:execute(nvim +{2} {1})'
}

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.dotnet:$PATH"
export PATH="/usr/local/go/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

# Secrets (API keys etc) — file created manually on each machine, never committed
[[ -f ~/.secrets ]] && source ~/.secrets
